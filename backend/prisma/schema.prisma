generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListStatus {
  active
  archived
  deleted
}

enum GiftItemState {
  available
  claimed
  purchased
}

enum SharePermissionLevel {
  shared
}

enum InvitationStatus {
  pending
  matched
  discarded
}

enum NameDisclosureConsent {
  pending
  revealed
  declined
}

// Email integration (feature 004).
enum OutboxKind {
  invite
  confirmation
}

enum OutboxStatus {
  queued
  sending
  sent
  failed
  superseded
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  ownedLists         GiftList[]
  ownedPermissions   SharePermission[] @relation("OwnerPermission")
  receivedPermissions SharePermission[] @relation("RecipientPermission")
  claimedItems       GiftItem[] @relation("Claimant")
  userSessions       UserSession[]
  auditEvents        AuditEvent[]   @relation("Actor")
  ownedInvitations   PendingInvitation[]
  outboxMessages     OutboxMessage[]

  // Email verification state (feature 004, D4/D5/D6). `verifiedAt === null`
  // is the unconfirmed state (no separate boolean). Only meaningful when email
  // is enabled; a disabled-mode account is created `verifiedAt = now`.
  verifiedAt              DateTime?
  verificationTokenHash   String?   // SHA-256 of the CURRENT raw token (raw never stored here)
  verificationExpiresAt   DateTime? // expiry of the current token (default now + 24h)
  verificationCreatedAt   DateTime? // when the current token was issued
}

model GiftList {
  id          String      @id @default(uuid())
  ownerUserId String
  owner       User        @relation(fields: [ownerUserId], references: [id])
  title       String
  description String?
  status      ListStatus  @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items             GiftItem[]
  sharePermissions  SharePermission[]
  pendingInvitations PendingInvitation[]
  outboxMessages    OutboxMessage[]
}

model GiftItem {
  id              String         @id @default(uuid())
  giftListId      String
  list            GiftList       @relation(fields: [giftListId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  quantity        Int?
  unitPrice       Decimal?
  state           GiftItemState  @default(available)
  claimantUserId  String?
  claimant        User?          @relation("Claimant", fields: [claimantUserId], references: [id])
  claimedAt       DateTime?
  purchasedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([giftListId])
}

model SharePermission {
  id             String               @id @default(uuid())
  giftListId     String
  list           GiftList             @relation(fields: [giftListId], references: [id], onDelete: Cascade)
  ownerUserId    String
  owner          User                 @relation("OwnerPermission", fields: [ownerUserId], references: [id])
  recipientUserId String
  recipient      User                 @relation("RecipientPermission", fields: [recipientUserId], references: [id])
  permission     SharePermissionLevel
  // Consent-gated identity disclosure (FR-020/FR-021/FR-023): the invitee's
  // email may be pre-populated when the invitation targets it, and the owner
  // only sees the recipient's name after they explicitly accept disclosure.
  recipientEmail        String?
  nameDisclosureConsent NameDisclosureConsent @default(pending)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([giftListId, recipientUserId])
  @@index([giftListId])
  @@index([recipientUserId])
}

// ---------------------------------------------------------------------------
// Security hardening (feature 003) — spec: specs/003-security-hardening/
// ---------------------------------------------------------------------------

/// Server-side session record backing the HttpOnly refresh cookie (FR-007/FR-008).
/// Only token *hashes* are stored — never raw tokens (FR-013).
/// `previousRefreshHash` supports one-step-back refresh-token rotation and
/// theft detection (FR-026).
model UserSession {
  id                  String    @id @default(uuid())
  userId              String
  refreshTokenHash    String
  previousRefreshHash String?
  issuedAt            DateTime  @default(now())
  lastRefreshAt       DateTime  @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
}

/// Append-only audit trail (FR-011/FR-012). Insert-only: the API exposes no
/// update or delete path and the app never prunes (FR-014).
model AuditEvent {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  targetType   String?
  targetId     String?
  outcome      String
  ip           String?
  detail       Json?
  createdAt    DateTime @default(now())

  actor User? @relation("Actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([targetType, targetId])
}

/// Pending email invitation for a gift list (FR-021). `giftListId` is the
/// single source of truth for the target — never the free-text `detail`
/// (FR-012). `status` starts `pending`; it becomes `matched` when the
/// invitee signs in and the invitation is consumed, or `discarded` when it
/// expires or is explicitly removed (FR-025).
model PendingInvitation {
  id           String           @id @default(uuid())
  giftListId   String
  inviteeEmail String
  ownerUserId  String
  status       InvitationStatus @default(pending)
  createdAt    DateTime         @default(now())
  expiresAt    DateTime?

  owner    User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  giftList GiftList @relation(fields: [giftListId], references: [id], onDelete: Cascade)

  @@unique([giftListId, inviteeEmail])
  @@index([inviteeEmail, status])
}

// ---------------------------------------------------------------------------
// Email integration (feature 004) — spec: specs/004-email-integration/
// ---------------------------------------------------------------------------

/// Durable, transactional email queue (D2). A row is committed in the SAME
/// Prisma transaction as the business write that produced it (the share, the
/// registration), then drained by a separate in-process loop (D2). The single
/// source of truth for "what should be sent, to whom, and what happened to it"
/// (FR-006, FR-007). Sensitive: a confirmation row's body embeds the raw
/// verification token — never returned by any API, read only by the drainer
/// and operators.
model OutboxMessage {
  id             String       @id @default(uuid())
  kind           OutboxKind
  // Normalized (trimmed, lowercased) delivery address AND the invite-dedup key.
  recipientEmail String
  // Set for `invite`, null for `confirmation` — the dedup discriminator.
  listId         String?
  // The account being confirmed (set for `confirmation`, null for `invite`).
  userId         String?
  subject        String
  bodyText       String
  bodyHtml       String?
  status         OutboxStatus @default(queued)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  nextAttemptAt  DateTime     @default(now())
  lastAttemptAt  DateTime?
  // Scrubbed error class/message (e.g. `provider_http_5xx`), never a provider key.
  lastError      String?
  sentAt         DateTime?
  supersededAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  list GiftList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Invite-dedup guarantee (FR-005, SC-001), enforced by the database.
  // Postgres treats NULL as distinct in a unique index, so:
  //   invite rows (listId non-null)   → at most one per (list, recipientEmail);
  //   confirmation rows (listId NULL) → unlimited per recipientEmail (FR-014).
  @@unique([listId, recipientEmail])
  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([listId])
}
